# Trecho para virtualhost HTTPS dedicado; não substitui nginx existente.
# DNS/certificados somente após autorização. A API e o gateway devem conhecer
# a mesma origem pública. Não publicar a aplicação Guacamole diretamente.
location /pdv-remote/ {
    proxy_pass https://127.0.0.1:8443/pdv-remote/;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_read_timeout 40s;
    proxy_send_timeout 15s;
    proxy_set_header Host $host;
    proxy_set_header Connection "";
    proxy_ssl_server_name on;
    proxy_ssl_name suporte.exemplo.invalid;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /CAMINHO_PRIVADO/ca-do-servidor-viewer.crt;
    client_max_body_size 64k;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-store" always;
    access_log off;
    # Não habilitar logs debug, bodies/cookies/headers ou telemetria de URLs.
}
# A saída do dispositivo é outro ingresso TCP/TLS passthrough dedicado
# até a porta local5443. Não terminar mTLS em proxy HTTP/ALB.
